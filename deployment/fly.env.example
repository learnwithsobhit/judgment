# Set on the Fly app after create/attach (do not commit secrets).
#   fly secrets set KEY=value -a judgment-api
#
# DATABASE_URL is normally set automatically by:
#   fly postgres attach <postgres-app-name> -a judgment-api

# Required — from Fly Postgres attach (or Neon/Supabase URL)
# DATABASE_URL=

# Comma-separated Firebase Hosting origins (no trailing slash)
ALLOWED_ORIGINS=https://judgment-lws-260731.web.app,https://judgment-lws-260731.firebaseapp.com

# Primary web origin for invite / WhatsApp share links
PUBLIC_WEB_ORIGIN=https://judgment-lws-260731.web.app

# v1 launch
RAG_ENABLED=0
RUST_LOG=info

# Optional rate limits
HTTP_RATE_LIMIT=120
HTTP_GUEST_RATE_LIMIT=20
HTTP_RATE_WINDOW_SECS=60

# Non-prod only: allow StartGameRequest.seed for deterministic deals
# JUDGEMENT_ALLOW_SEED=1
