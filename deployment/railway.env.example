# Copy these into the Railway API service Variables UI (or `railway variables`).
# Do not commit real secrets. DATABASE_URL is usually injected by the Postgres plugin.

# Required — Railway Postgres plugin reference, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Railway injects PORT; the server already binds 0.0.0.0:$PORT
# PORT=8080

# Comma-separated Firebase Hosting origins (no trailing slash)
# Example: https://my-app.web.app,https://my-app.firebaseapp.com
ALLOWED_ORIGINS=

# Primary web origin for invite / WhatsApp share links (Firebase URL)
PUBLIC_WEB_ORIGIN=

# v1 launch: keep RAG off (Railway Postgres has no pgvector by default)
RAG_ENABLED=0

# Optional — Firebase project id for Google sign-in (RS256 JWKS).
# Unset, and without JUDGEMENT_FIREBASE_DEV_SECRET, POST /api/v1/auth/firebase returns 400.
FIREBASE_PROJECT_ID=

# Local only. HS256 issuer judgement-dev. Do not set this in production.
# JUDGEMENT_FIREBASE_DEV_SECRET=

# Stats capture on a natural finish. Unset means on. 0 or false turns it off.
STATS_ENABLED=1

RUST_LOG=info

# Seconds a dropped seat stays reserved before it goes vacant (default 30, max 120).
RECONNECT_GRACE_SECONDS=30

# Comma-separated, case-insensitive. These accounts see Table look in profile.
ADMIN_EMAILS=chaturvedi99@gmail.com

# Optional rate limits (defaults match docker-compose.prod.yml).
# Board (Top players / Fair play / Tournament) and landing polls use separate
# buckets so home-screen polling cannot starve the leaderboard sheet.
HTTP_RATE_LIMIT=120
HTTP_GUEST_RATE_LIMIT=20
HTTP_BOARD_RATE_LIMIT=60
HTTP_POLL_RATE_LIMIT=90
HTTP_RATE_WINDOW_SECS=60

# Optional — only if enabling Rig / OpenAI features later
# OPENAI_API_KEY=
