# Copy these into the Railway API service Variables UI (or `railway variables`).
# Do not commit real secrets. DATABASE_URL is usually injected by the Postgres plugin.
#
# Test stack: Firebase Auth project `judgment-railway-test` + Hosting
# https://judgment-railway-test.web.app → this Railway API.

# Required — Railway Postgres plugin reference, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Railway injects PORT; the server already binds 0.0.0.0:$PORT
# PORT=8080

# Comma-separated Firebase Hosting origins (no trailing slash)
ALLOWED_ORIGINS=https://judgment-railway-test.web.app,https://judgment-railway-test.firebaseapp.com

# Primary web origin for invite / WhatsApp share links
PUBLIC_WEB_ORIGIN=https://judgment-railway-test.web.app

# Firebase Auth project that issues ID tokens (must match flutterfire / client)
FIREBASE_PROJECT_ID=judgment-railway-test

# Avatar uploads (optional until S3 is ready — leave unset to disable)
# MEDIA_BACKEND=s3
# S3_BUCKET=judgement-avatars
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BASE_URL=https://dxxxx.cloudfront.net

# v1 launch: keep RAG off (Railway Postgres has no pgvector by default)
RAG_ENABLED=0

RUST_LOG=info

# Optional rate limits (defaults match docker-compose.prod.yml)
HTTP_RATE_LIMIT=120
HTTP_GUEST_RATE_LIMIT=20
HTTP_RATE_WINDOW_SECS=60

# Optional — only if enabling Rig / OpenAI features later
# OPENAI_API_KEY=
