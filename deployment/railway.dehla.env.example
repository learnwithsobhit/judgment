# Env for Railway Dehla service (do not reuse Judgement DATABASE_URL).
PORT=8080
RUST_LOG=info
# DATABASE_URL=postgresql://...   # enable Postgres tip store (CP)
DEHLA_MIGRATIONS_DIR=/srv/migrations/dehla
# Shell host for invites — not the Judgement SPA
PUBLIC_WEB_ORIGIN=https://dehla-railway-test.web.app
# Comma-separated; unset = permissive (local only)
ALLOWED_ORIGINS=https://dehla-railway-test.web.app
