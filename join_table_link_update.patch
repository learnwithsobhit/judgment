+/// A second phone of the same account takes the seat it already has.
+async fn rebind_same_account(
+    state: &AppState,
+    session: &Session,
+    room_id: RoomId,
+    mine: &HashSet<SessionId>,
+) -> Result<Option<JoinRoomResponse>, ApiError> {
+    if mine.is_empty() {
+        return Ok(None);
+    }
+    let found = {
+        let rooms = state.rooms.lock().unwrap();
+        let Some(room) = rooms.get(&room_id) else {
+            return Ok(None);
+        };
+        room.seats
+            .iter()
+            .find(|seat| mine.contains(&seat.session_id) && seat.session_id != session.id)
+            .map(|seat| {
+                (
+                    seat.player_id,
+                    seat.session_id,
+                    matches!(room.status, RoomStatus::InGame(_)),
+                )
+            })
+    };
+    let Some((player_id, old_session, in_game)) = found else {
+        return Ok(None);
+    };
+    if in_game {
+        let mut games = state.games.lock().unwrap();
+        if let Some(info) = games.values_mut().find(|info| info.room_id == room_id) {
+            info.players.remove(&old_session);
+            info.players.insert(session.id, player_id);
+        }
+    }
+    let (mut view, snapshot) = {
+        let mut rooms = state.rooms.lock().unwrap();
+        let Some(room) = rooms.get_mut(&room_id) else {
+            return Ok(None);
+        };
+        if room.host_session == old_session {
+            room.host_session = session.id;
+        }
+        let Some(seat) = room
+            .seats
+            .iter_mut()
+            .find(|seat| seat.player_id == player_id)
+        else {
+            return Ok(None);
+        };
+        seat.session_id = session.id;
+        seat.nickname = session.nickname.clone();
+        seat.avatar_id = session.avatar_id.clone();
+        (room.view(), stored_room(room))
+    };
+    state
+        .store
+        .upsert_room(&snapshot)
+        .await
+        .map_err(|e| ApiError::Conflict(format!("persist room: {e}")))?;
+    if in_game {
+        enrich_room_vacancy(state, &mut view).await;
+    }
+    crate::leaderboard::stamp_room_ladder_ranks(state, &mut view);
+    Ok(Some(JoinRoomResponse {
+        room: view,
+        player_id,
+    }))
+}
